# ── Required ──────────────────────────────────────────────
# Public URL of the site (http://localhost:3000 locally, your Vercel URL in production)
APP_URL=http://localhost:3000
# The ONLY Google account allowed to sign in (your Gmail)
ALLOWED_EMAIL=
# Random 32+ char secret: run `openssl rand -base64 32`
SESSION_SECRET=

# ── Google (Calendar + Drive + login) ─────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Claude (Opus 5.5 editor + AI scheduling) ──────────────
ANTHROPIC_API_KEY=
# Max Claude requests per hour (API protection)
AI_MAX_REQUESTS_PER_HOUR=60

# ── Database ──────────────────────────────────────────────
# Supabase Postgres connection string (Transaction pooler, port 6543).
# Leave empty locally to use the built-in database in ./.data
DATABASE_URL=

# ── Local development only ────────────────────────────────
# Lets you sign in without Google while developing. Ignored in production.
DEV_LOGIN=false
